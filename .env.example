# Copie este arquivo para ".env" e preencha. O ".env" NÃO vai para o GitHub (está no .gitignore).
# Sem nenhuma variável, o app funciona em modo demonstração com SMS simulado.

# ---------------------------------------------------------------- SMS / WhatsApp real (Twilio)
# simulado (padrão) | twilio
SMS_PROVEDOR=simulado
# sms (padrão) | whatsapp
SMS_CANAL=sms
# Console do Twilio → página inicial (Account Info)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número do Twilio que envia (formato +1XXXXXXXXXX). Para WhatsApp (sandbox): whatsapp:+14155238886
TWILIO_FROM=
# Alternativa ao TWILIO_FROM: um Messaging Service (MGxxxxxxxx)
TWILIO_MESSAGING_SERVICE_SID=

# ---------------------------------------------------------------- Segurança
# Senha do painel da equipe (padrão de demonstração: ubs123)
PAINEL_SENHA=ubs123
# Chave das sessões (64 caracteres hexadecimais). Sem ela, uma nova é gerada a cada início
# e todos precisam entrar de novo. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSAO_SEGREDO=

# ---------------------------------------------------------------- Demonstração
# 1 = mostra o código do SMS na tela e o painel de demonstração; 0 = desliga (uso real)
DEMO=1
# Espera entre tentativas de SMS: 1000 (demo, segundos) | 60000 (produção: 1, 2, 4, 8, 16 minutos)
BACKOFF_UNIT_MS=1000
